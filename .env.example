# Copy to `.env` next to docker-compose.yml. Everything here is optional
# except that you need at least ONE way to reach Docksentry: the Web UI,
# Telegram, or one of the notification channels. See docs/configuration.md
# for all 86 variables.

# ── the Web UI ────────────────────────────────────────────────────────
# Setting this is only half of it — also uncomment the `ports:` block in
# docker-compose.yml, or the interface runs where nothing can reach it.
# The first visit walks you through setting a password.
WEB_UI=true
WEB_PORT=8080

# ── Telegram (optional) ───────────────────────────────────────────────
# Token from @BotFather; chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot.
BOT_TOKEN=
CHAT_ID=

# ── what docker-compose.yml interpolates ──────────────────────────────
# Where your compose projects live on the host. Must match the path in
# the containers' compose labels — see docs/compose.md. Mounted read-only.
COMPOSE_DIR=/data/compose
# Your Docker credentials FILE, for authenticated pulls (rate limits).
DOCKER_CONFIG=/root/.docker/config.json

# ── behaviour ─────────────────────────────────────────────────────────
# Daily at 18:00.
CRON_SCHEDULE=0 18 * * *
# Comma-separated names to leave alone; wildcards allowed (systemd-*).
EXCLUDE_CONTAINERS=
TZ=Europe/Berlin
